# Copy to .env and edit. .env is git-ignored; never commit real credentials.

# PostgreSQL connection used by the backend, scripts/init_database.py and ML training.
DATABASE_URL=postgresql+psycopg://ember_atlas:change-me@127.0.0.1:5432/ember_atlas
# PostgreSQL database for the integration tests (they create and drop isolated schemas). Defaults to DATABASE_URL.
EMBER_ATLAS_TEST_DATABASE_URL=

# Ports: FastAPI and the Vite dev server (the dev server proxies /api to API_PORT).
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173

# Optional: relocate the dataset folder (defaults to ./dataset).
EMBER_ATLAS_DATASET_DIR=

# Optional local review queue for AI-assisted findings (off by default; never enable on a public deployment).
EMBER_ATLAS_REVIEW_ENABLED=0
EMBER_ATLAS_REVIEWER_TOKEN=
# Optional LLM provider for /api/ask. Empty = deterministic extractive answers (no LLM). None is configured by default.
EMBER_ATLAS_LLM_PROVIDER=
